# 数据库连接（宿主机 MySQL）
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/ai_chat?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT (生成方式: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-base64-encoded

# AI 模型供应商 API Key
SPRING_AI_DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 联网搜索（可选）
TAVILY_API_KEY=tvly-your-tavily-api-key

# 默认模型配置（可选）
APP_DEFAULT_MODEL_PROVIDER=openai
APP_DEFAULT_MODEL_NAME=qwen3.6-flash-2026-04-16
APP_DEFAULT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
